# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
CLOUDFLARE_TUNNEL_TOKEN=replace_me

# Local development secrets. Replace these before exposing the stack publicly.
POSTGRES_PASSWORD=echo_local_dev_only_change_me
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_before_public_use
