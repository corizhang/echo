# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token
CLOUDFLARE_TUNNEL_TOKEN=replace_me

# Local development secrets. Replace these before exposing the stack publicly.
ECHO_INSTANCE_ID=local
POSTGRES_PASSWORD=echo_local_dev_only_change_me
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_before_public_use

# Private test accounts (no public registration). Use separate random passwords, at least 16 characters.
ECHO_TEST_LIN_PASSWORD=replace-with-a-long-random-password
ECHO_TEST_MORI_PASSWORD=replace-with-a-long-random-password

# QUIC/UDP game relay certificate, as seen from the VPS host. Used with the
# optional `--profile quic` Docker Compose profile. The cert must cover the
# same DNS name configured as ECHO_SERVER_URL for Windows desktop builds.
ECHO_QUIC_CERT_FILE=/opt/echo/quic-certs/echo.crt
ECHO_QUIC_KEY_FILE=/opt/echo/quic-certs/echo.key

# Diagnostic mode: compat fixes the server UDP payload to 1200 bytes.
ECHO_QUIC_TRANSPORT_MODE=standard
